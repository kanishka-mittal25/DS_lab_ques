#include <stdio.h>

int linearSearch(int arr[], int n, int key) {
    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            return i; // Element mil gaya, index return karo
        }
    }
    return -1; // Element nahi mila
}

int main() {
    int arr[] = {12, 45, 23, 67, 89, 34};
    int n = sizeof(arr) / sizeof(arr[0]);
    int key = 67;

    int result = linearSearch(arr, n, key);

    if (result != -1) {
        printf("Linear Search: Element %d Index %d par mil gaya hai.\n", key, result);
    } else {
        printf("Linear Search: Element %d array me nahi hai.\n", key);
    }

    return 0;
}
