#include <stdio.h>

void traverse(int arr[], int n) {
    printf("Array elements: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int insert(int arr[], int n, int element, int capacity, int index) {
    if (n >= capacity) return n;
    for (int i = n - 1; i >= index; i--) {
        arr[i + 1] = arr[i];
    }
    arr[index] = element;
    return n + 1;
}

int deleteElement(int arr[], int n, int index) {
    if (index >= n) return n;
    for (int i = index; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }
    return n - 1;
}

int main() {
    int arr[100] = {10, 20, 30, 40, 50};
    int n = 5;

    // Traversal
    traverse(arr, n);

    // Insertion
    n = insert(arr, n, 25, 100, 2);
    printf("After Insertion: ");
    traverse(arr, n);

    // Deletion
    n = deleteElement(arr, n, 3);
    printf("After Deletion: ");
    traverse(arr, n);

    return 0;
}
