#include <stdio.h>

int binarySearch(int arr[], int n, int key) {
    int low = 0;
    int high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        // Agar element middle par hi mil jaye
        if (arr[mid] == key) {
            return mid;
        }

        // Agar key middle se badi hai, toh left half ko ignore karo
        if (arr[mid] < key) {
            low = mid + 1;
        } 
        // Agar key middle se chhoti hai, toh right half ko ignore karo
        else {
            high = mid - 1;
        }
    }

    return -1; // Element nahi mila
}

int main() {
    // Array ka sorted hona zaroori hai
    int arr[] = {10, 20, 30, 40, 50, 60, 70};
    int n = sizeof(arr) / sizeof(arr[0]);
    int key = 40;

    int result = binarySearch(arr, n, key);

    if (result != -1) {
        printf("Binary Search: Element %d Index %d par mil gaya hai.\n", key, result);
    } else {
        printf("Binary Search: Element %d array me nahi hai.\n", key);
    }

    return 0;
}
